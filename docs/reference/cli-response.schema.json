{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marsa CLI response",
  "oneOf": [
    { "$ref": "#/$defs/help" },
    { "$ref": "#/$defs/completion" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/disk_usage" }
  ],
  "$defs": {
    "disk_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "host", "guest", "categories"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "disk_usage" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allocated_bytes", "capacity_bytes"],
          "properties": {
            "allocated_bytes": { "type": "integer", "minimum": 0 },
            "capacity_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "guest": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["used_bytes", "capacity_bytes"],
          "properties": {
            "used_bytes": { "type": "integer", "minimum": 0 },
            "capacity_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "used_bytes", "reclaimable_bytes"],
            "properties": {
              "category": { "enum": ["unspecified", "containers", "images", "volumes", "networks", "build_cache"] },
              "used_bytes": { "type": "integer", "minimum": 0 },
              "reclaimable_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "help": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "text"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "help" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "shell", "script"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "completion" },
        "shell": { "enum": ["bash", "fish", "zsh"] },
        "script": { "type": "string", "minLength": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "code", "message"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "error" },
        "code": { "enum": ["confirmation_required", "invalid_invocation", "not_available", "connection_failed", "home_unavailable", "unprivileged_user_required", "incompatible_daemon", "operation_failed"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
